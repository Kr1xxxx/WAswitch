{
  "name": "waswitch",
  "version": "0.3.0",
  "description": "在一个窗口里同时登录多个 WhatsApp 账号（每个账号独立会话）",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "electron scripts/check-isolation.js",
    "check:mcp": "node scripts/check-mcp.js",
    "check:lite": "node scripts/run-check-lite.js",
    "check:wa-page": "electron scripts/check-wa-page.js",
    "check:view-race": "node scripts/check-view-race.js",
    "dist": "electron-builder",
    "check:updater": "node scripts/check-updater.js"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "baileys": "7.0.0-rc14",
    "electron-updater": "6.8.10",
    "https-proxy-agent": "9.1.0",
    "qrcode": "1.5.4",
    "socks-proxy-agent": "10.1.0",
    "undici": "7.30.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.waswitch.app",
    "productName": "WAswitch",
    "files": [
      "src/**/*",
      "bin/**/*",
      "assets/**/*"
    ],
    "icon": "assets/icon.png",
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "target": "AppImage"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Kr1xxxx",
        "repo": "WAswitch"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true
    }
  }
}
