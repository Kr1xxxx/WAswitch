{
  "name": "waswitch",
  "version": "0.5.15",
  "description": "在一个窗口里同时登录多个 WhatsApp 账号（每个账号独立会话）",
  "main": "src/main.js",
  "scripts": {
    "check:audit": "node scripts/check-audit.js && node scripts/check-audit-server.mjs && node scripts/check-editor-save.js && node scripts/check-direct-tz.js && node scripts/run-check-electron.js scripts/check-audit-ui.js scripts/check-editor-ui.js scripts/check-direct-tz-editor.js",
    "start": "electron .",
    "check": "electron scripts/check-isolation.js",
    "check:middot": "node scripts/check-no-middot.js",
    "check:agents": "node scripts/check-agents-md.js",
    "check:ime-enter": "node scripts/check-ime-enter.js",
    "check:emoji": "node scripts/check-emoji.js",
    "check:mcp": "node scripts/check-mcp.js && node scripts/check-mcp-search.js && node scripts/check-mcp-customer-search.js && node scripts/check-mcp-helpers.js && node scripts/check-mcp-customers.js && node scripts/check-open-chat.js && node scripts/check-mcp-module.js",
    "check:review": "node scripts/check-review.mjs && node scripts/check-review2.mjs",
    "check:lite": "node scripts/run-check-lite.js",
    "check:lite-unread": "node scripts/check-lite-unread.mjs",
    "check:wa-page": "electron scripts/check-wa-page.js",
    "check:draft": "electron scripts/check-draft.js",
    "check:read-messages": "electron scripts/check-read-messages.js",
    "check:view-race": "node scripts/check-view-race.js",
    "check:qr-watch": "node scripts/check-qr-watch.js",
    "check:memory": "node scripts/check-memory.js",
    "check:offline": "node scripts/check-offline.js",
    "check:notify": "node scripts/check-notify.js && node scripts/check-notify-reconnect.js",
    "check:popup": "electron scripts/check-popup.js",
    "dist": "electron-builder",
    "check:updater": "node scripts/check-updater.js",
    "check:ports": "node scripts/check-ports.js && node scripts/check-proxy-pass.js",
    "check:atomic": "node scripts/check-atomic.js && node scripts/check-account-id.js",
    "check:editor": "node scripts/check-editor-save.js",
    "check:records": "node scripts/check-records.js && node scripts/check-undo.js",
    "check:import": "node scripts/check-import.js",
    "check:downloads": "node scripts/check-downloads.js",
    "check:translate": "node scripts/check-drafts.js && node scripts/check-translate.js && node scripts/check-reply-lang.js && node scripts/check-errtext.js && node scripts/check-outcache.js",
    "check:customer-time": "node scripts/check-customer-time.js",
    "check:float": "node scripts/check-float.js && electron scripts/check-float.js",
    "check:font-sizes": "node scripts/check-font-sizes.js",
    "check:colors": "node scripts/check-colors.js",
    "make:colors": "node scripts/make-colors.js",
    "check:radius-motion": "node scripts/check-radius-motion.js",
    "check:visual": "node scripts/check-visual.js",
    "check:dock-scroll": "electron scripts/check-dock-scroll.js",
    "check:dock-draft": "electron scripts/check-dock-draft.js",
    "check:add-menu": "electron scripts/check-add-menu.js",
    "check:topbar": "electron scripts/check-topbar-fit.js",
    "check:container": "electron scripts/check-container-layout.js",
    "check:sel-translate": "electron scripts/check-sel-translate.js",
    "check:tp-swap": "electron scripts/check-tp-swap.js",
    "check:trpage-busy": "electron scripts/check-trpage-busy.js",
    "check:tr-wait": "electron scripts/check-tr-wait.js",
    "check:tr-keys": "electron scripts/check-tr-keys.js",
    "check:team": "node scripts/check-team.mjs && node server/test/run.mjs && node scripts/check-crm.mjs",
    "build:mcp": "node scripts/build-mcp.js --embed"
  },
  "license": "MIT",
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "electron-updater": "6.8.10",
    "https-proxy-agent": "9.1.0",
    "qrcode": "1.5.4",
    "socks-proxy-agent": "10.1.0",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@radix-ui/colors": "3.0.0",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "zod": "3.25.76"
  },
  "build": {
    "appId": "com.waswitch.app",
    "productName": "WAswitch",
    "electronLanguages": [
      "zh-CN",
      "zh_CN",
      "zh-TW",
      "zh_TW",
      "en-US",
      "en"
    ],
    "files": [
      "src/**/*",
      "!src/fonts/misans{,/**/*}",
      "!src/mcp/**/*",
      "src/mcp/settings.html",
      "src/mcp/settings.js",
      "src/mcp/preload.js",
      "assets/**/*",
      "!**/node_modules/**/*.{map,md,markdown,d.ts,d.mts,d.cts}",
      "**/node_modules/**/{LICENSE,LICENCE,license,licence}.{md,markdown}"
    ],
    "icon": "assets/icon.png",
    "win": {
      "files": [
        "src/fonts/misans/**/*"
      ],
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon-mac.png"
    },
    "dmg": {
      "background": "build/background.png",
      "iconSize": 96,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 170,
          "type": "file"
        },
        {
          "x": 400,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Kr1xxxx",
        "repo": "WAswitch"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "multiLanguageInstaller": false,
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh"
    }
  }
}
