{
  "name": "waswitch",
  "version": "0.1.0",
  "description": "在一个窗口里同时登录多个 WhatsApp 账号（每个账号独立会话）",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "electron scripts/check-isolation.js",
    "check:mcp": "node scripts/check-mcp.js",
    "dist": "electron-builder"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.waswitch.app",
    "productName": "WAswitch",
    "files": ["src/**/*", "bin/**/*", "assets/**/*"],
    "icon": "assets/icon.png",
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
