{
  // WAswitch 团队后台。部署：Cloudflare Workers Builds 连 GitHub，只从 main 分支部署，根目录 server。
  // 必须在控制台设置的环境变量（不放进公开仓库）：OWNER_EMAIL、ACCESS_TEAM_DOMAIN、ACCESS_AUD。
  "name": "waswitch-team",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // 审计要求：关掉 workers.dev 和预览网址（预览版本连同一个 D1，又不在 Access 保护的域名下）
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // 先跑 Worker 验 Access，再给静态文件
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "waswitch-team",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // 每天清理一次；每 30 分钟把聊天推给来财
  "triggers": { "crons": ["17 19 * * *", "*/30 * * * *"] },
  // CRM_PUSH：来财接收入口做好、真实客户上云、验收通过后才改成 "1"。没开时电脑不上传聊天
  "vars": { "SYNC_INTERVAL_S": "120", "CRM_PUSH": "0" },
  // 聊天同步：来财那边的命名入口做好后再取消注释（Worker 不存在时部署会失败）
  // "services": [{ "binding": "LAICRM", "service": "laicrm-app", "entrypoint": "WaswitchIngest" }],
  // 另外两个 secret 由老板自己放（wrangler secret put），不写在这里：
  //   CRM_KEY        32 字节随机数的 base64，用来加密暂存的聊天和算消息编号
  //   LAICRM_SECRET  推送签名密钥，和来财的 WASWITCH_INGEST_SECRET 一样
  "observability": { "enabled": true }
}
