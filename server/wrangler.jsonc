{
  // WAswitch 团队后台。部署：Cloudflare Workers Builds 连 GitHub，只从 main 分支部署，根目录 server。
  // 在控制台放的一律用 Secret 类型（普通变量每次部署会被这个文件覆盖）：
  //   RESEND_API_KEY（必须，发验证码邮件）、OWNER_EMAIL（必须，老板邮箱）、MAIL_FROM（可选，发件人）
  //   ACCESS_TEAM_DOMAIN、ACCESS_AUD（可选，再加一道 Cloudflare Access）
  "name": "waswitch-teama",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // 审计要求：关掉 workers.dev 和预览网址（预览版本连同一个 D1）
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // 先跑 Worker（加安全头；配了 Access 时先验 Access），再给静态文件
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "waswitch-team",
      "database_id": "b6a2215c-22c4-44b6-87e8-6df1c71ebfe4",
      "migrations_dir": "migrations"
    }
  ],
  // 只用一个定时任务（免费版一个账号最多 5 个，和来财共用）：每 30 分钟推聊天，每天 UTC 19:00 那次顺便清理
  "triggers": { "crons": ["*/30 * * * *"] },
  // CRM_PUSH：来财接收入口已上线（2026-11-03，来财 3.10），打开。团队里每个号的单聊文字都同步，没有按号的开关。
  // CRM_KEY、LAICRM_SECRET 没放好时上传回 503，电脑留着本机队列。
  "vars": { "SYNC_INTERVAL_S": "120", "CRM_PUSH": "1" },
  // 聊天同步：推给来财 laicrm-app 的命名入口 WaswitchIngest（同一个 Cloudflare 账号）
  "services": [{ "binding": "LAICRM", "service": "laicrm-app", "entrypoint": "WaswitchIngest" }],
  // 另外两个 secret 由老板自己放（wrangler secret put），不写在这里：
  //   CRM_KEY        32 字节随机数的 base64，用来加密暂存的聊天和算消息编号
  //   LAICRM_SECRET  推送签名密钥，和来财的 WASWITCH_INGEST_SECRET 一样
  "observability": { "enabled": true }
}
